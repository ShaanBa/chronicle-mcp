# Chronicle MCP Server Configuration
# Copy this file to .env and customize for your deployment

# HTTP Port (default: 8787)
CHRONICLE_HTTP_PORT=8787

# Authentication Bearer Token (Required)
CHRONICLE_AUTH_TOKEN=your-secure-bearer-token-here

# OAuth 2.1 Configuration
CHRONICLE_OAUTH_CLIENT_ID=chronicle-gemini
CHRONICLE_OAUTH_CLIENT_SECRET=your-oauth-client-secret-here

# Optional: Custom Data Storage Directory (defaults to ./data)
# CHRONICLE_DATA_DIR=./data
